# UniMeet Backend Environment Configuration
APP_NAME=UniMeet API
APP_VERSION=0.1.0
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# SQLite database URL (relative to backend/ when running uvicorn from backend/)
DATABASE_URL=sqlite:///./unimeet.db

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# JWT Configuration (override JWT_SECRET_KEY in local .env and production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie authentication settings
COOKIE_NAME=unimeet_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
